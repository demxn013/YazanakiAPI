# Copy this to .env and fill in your values
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Port the API listens on
API_PORT=3000

# Secret key the mod sends with every request to prevent random people hitting your API
API_SECRET=change_this_to_a_long_random_string

# ── Cosmetic writes (launcher purchases) ────────────────────────────────────
# The API forwards verified purchases to KenzAI's private internal endpoint
# (KenzAI is the single writer of points). Point these at the running KenzAI
# process and use the SAME secret KenzAI has in COSMETICS_INTERNAL_SECRET.
# Keep that endpoint private (localhost / internal network), never internet-facing.
KENZAI_INTERNAL_URL=http://127.0.0.1:4825
COSMETICS_INTERNAL_SECRET=change_this_to_match_kenzai
